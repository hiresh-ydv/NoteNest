# NoteNest backend environment (all optional; defaults shown).
# Copy to `.env` and adjust. Never commit a real `.env` or a real secret.

# Database and file storage
NOTENEST_DATABASE_URL=sqlite:///notenest.db
NOTENEST_UPLOAD_DIR=uploads
NOTENEST_MAX_UPLOAD_SIZE=10485760

# Browser origins allowed to call the API (comma separated)
NOTENEST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication
# REQUIRED in production: set a long random value (32+ bytes) and keep it secret.
NOTENEST_SECRET_KEY=replace-with-a-long-random-secret
NOTENEST_ACCESS_TOKEN_TTL=86400
NOTENEST_COOKIE_NAME=notenest_session
# Set to true only when serving over HTTPS.
NOTENEST_COOKIE_SECURE=false
NOTENEST_COOKIE_SAMESITE=lax
